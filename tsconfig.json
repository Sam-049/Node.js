{
  "compilerOptions": {
    /* Runtime Environment & Target */
    "target": "ES2022" /* Specify ECMAScript target version */,
    "module": "NodeNext" /* Set module system for modern Node.js */,
    "moduleResolution": "NodeNext" /* Mimic Node.js resolution algorithms */,
    "lib": ["ES2022"] /* Specify library files to be included */,

    /* Build Artifacts */
    "outDir": "./dist" /* Redirect output structure to the directory */,
    "rootDir": "src" /* Specify the root directory of input files */,
    "sourceMap": true /* Create source map files for debugging */,
    "removeComments": true /* Do not emit comments to output */,

    /* Strict Type-Checking Options */
    "strict": true /* Enable all strict type-checking options */,
    "noImplicitAny": true /* Raise error on expressions and declarations with an implied 'any' type */,
    "strictNullChecks": true /* Enable strict null checks */,

    /* Additional Checks */
    "noUnusedLocals": true /* Report errors on unused locals */,
    "noUnusedParameters": true /* Report errors on unused parameters */,
    "noImplicitReturns": true /* Report error when not all code paths in function return a value */,
    "noFallthroughCasesInSwitch": false /* Report errors for fallthrough cases in switch statement */,

    /* Interoperability & Optimization */
    "esModuleInterop": true /* Enables interoperability between CommonJS and ES Modules */,
    "forceConsistentCasingInFileNames": true /* Disallow inconsistently-cased references to the same file */,
    "skipLibCheck": true /* Skip type checking of declaration files */,
    "types": ["node"]
  },
  "include": ["src/**/*"] /* Include all files under the src directory */,
  "exclude": [
    "node_modules",
    "dist"
  ] /* Exclude dependencies and production build outputs */
}
